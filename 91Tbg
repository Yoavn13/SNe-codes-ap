# ============================================================
# BASIC HELPERS
# ============================================================

def clean_value(value):

    if value is None:
        return np.nan

    try:
        if np.ma.is_masked(value):
            return np.nan
    except Exception:
        pass

    if isinstance(value, bytes):

        return value.decode(
            "utf-8",
            errors="replace"
        ).strip()

    try:
        return value.item()

    except Exception:
        return value


def normalize(text):

    return "".join(
        ch.lower()
        for ch in str(text)
        if ch.isalnum()
    )


def numeric_value(value):

    value = clean_value(value)

    try:

        number = float(value)

        if np.isfinite(number):
            return number

    except Exception:
        pass

    return np.nan


def text_value(value):

    value = clean_value(value)

    try:

        if pd.isna(value):
            return ""

    except Exception:
        pass

    return str(value).strip()


def bool_value(value):

    value = clean_value(value)

    if isinstance(value, bool):
        return value

    text = str(value).strip().lower()

    return text in {
        "true",
        "1",
        "yes",
        "y",
        "t"
    }


# ============================================================
# TIME DISPLAY
# ============================================================

def format_seconds(seconds):

    if not np.isfinite(seconds):
        return "unknown"

    seconds = int(max(0, seconds))

    hours = seconds // 3600

    minutes = (
        seconds % 3600
    ) // 60

    remaining_seconds = (
        seconds % 60
    )

    if hours > 0:

        return (
            f"{hours}h "
            f"{minutes}m "
            f"{remaining_seconds}s"
        )

    if minutes > 0:

        return (
            f"{minutes}m "
            f"{remaining_seconds}s"
        )

    return (
        f"{remaining_seconds}s"
    )


# ============================================================
# NED REQUEST
# ============================================================

def request_votable(
    url,
    params,
    object_name,
    request_type
):

    for attempt in range(
        1,
        MAX_RETRIES + 1
    ):

        try:

            response = requests.get(
                url,
                params=params,
                timeout=REQUEST_TIMEOUT
            )

            response.raise_for_status()

            votable = parse(
                io.BytesIO(
                    response.content
                )
            )

            return votable, True


        except Exception as error:

            print()

            print(
                f"NED {request_type} query failed:",
                object_name
            )

            print(
                "Attempt:",
                attempt,
                "of",
                MAX_RETRIES
            )

            print(
                "Error:",
                error
            )


            if attempt < MAX_RETRIES:

                wait_time = min(
                    5 * (
                        2 ** (
                            attempt - 1
                        )
                    ),
                    60
                )

                print(
                    "Waiting",
                    wait_time,
                    "seconds before retry..."
                )

                time.sleep(
                    wait_time
                )


    print()

    print(
        "All attempts failed for:",
        object_name
    )

    return None, False


# ============================================================
# VOTABLE FIELD RECORDS
# ============================================================

def all_field_records(votable):

    records = []

    if votable is None:
        return records


    for resource in votable.resources:

        for table_element in resource.tables:

            try:

                table = (
                    table_element.to_table()
                )

            except Exception:
                continue


            if table is None:
                continue

            if len(table) == 0:
                continue


            for index, field in enumerate(
                table_element.fields
            ):

                if index >= len(
                    table.colnames
                ):
                    continue


                records.append({

                    "table":
                        table,

                    "column":
                        table.colnames[index],

                    "name":
                        str(
                            field.name or ""
                        ),

                    "id":
                        str(
                            field.ID or ""
                        ),

                    "description":
                        str(
                            field.description or ""
                        ),

                    "unit":
                        str(
                            field.unit or ""
                        )
                })


    return records


def first_number_from_record(record):

    table = record["table"]
    column = record["column"]

    for value in table[column]:

        number = numeric_value(
            value
        )

        if np.isfinite(number):
            return number

    return np.nan


def first_text_from_record(record):

    table = record["table"]
    column = record["column"]

    for value in table[column]:

        text = text_value(
            value
        )

        if text:
            return text

    return ""


# ============================================================
# EXACT FIELD LOOKUP
# ============================================================

def get_number_exact(
    votable,
    labels
):

    targets = [
        normalize(label)
        for label in labels
    ]


    for record in all_field_records(
        votable
    ):

        field_name = normalize(
            record["name"]
        )

        field_id = normalize(
            record["id"]
        )


        for target in targets:

            if (
                field_name == target
                or
                field_id == target
            ):

                value = (
                    first_number_from_record(
                        record
                    )
                )

                if np.isfinite(value):
                    return value


    return np.nan


def get_text_exact(
    votable,
    labels
):

    targets = [
        normalize(label)
        for label in labels
    ]


    for record in all_field_records(
        votable
    ):

        field_name = normalize(
            record["name"]
        )

        field_id = normalize(
            record["id"]
        )


        for target in targets:

            if (
                field_name == target
                or
                field_id == target
            ):

                value = (
                    first_text_from_record(
                        record
                    )
                )

                if value:
                    return value


    return ""


# ============================================================
# FIND COLUMN IN NED TABLE
# ============================================================

def find_table_column(
    table_element,
    table,
    labels
):

    targets = [
        normalize(label)
        for label in labels
    ]


    for index, field in enumerate(
        table_element.fields
    ):

        if index >= len(
            table.colnames
        ):
            continue


        names = [

            normalize(
                field.name or ""
            ),

            normalize(
                field.ID or ""
            )
        ]


        for target in targets:

            if target in names:

                return (
                    table.colnames[index]
                )


    return None


# ============================================================
# SUPERNOVA REDSHIFT TABLE
# ============================================================

def get_ned_redshift_measurements(
    sn_name
):

    params = {
        "TARGET":
            str(sn_name).strip()
    }


    votable, query_success = request_votable(

        NED_REDSHIFTS_URL,

        params,

        sn_name,

        "redshift"
    )


    measurements = []


    if not query_success:

        return (
            measurements,
            False
        )


    if votable is None:

        return (
            measurements,
            True
        )


    for resource in votable.resources:

        for table_element in resource.tables:

            try:

                table = (
                    table_element.to_table()
                )

            except Exception:
                continue


            if (
                table is None
                or
                len(table) == 0
            ):
                continue


            z_col = find_table_column(
                table_element,
                table,
                [
                    "Redshift (z)",
                    "Redshift"
                ]
            )


            unc_col = find_table_column(
                table_element,
                table,
                [
                    "Redshift(z) Unc",
                    "Redshift Unc"
                ]
            )


            technique_col = find_table_column(
                table_element,
                table,
                ["Technique"]
            )


            method_col = find_table_column(
                table_element,
                table,
                ["Method"]
            )


            quality_col = find_table_column(
                table_element,
                table,
                ["Quality Flag"]
            )


            reference_col = find_table_column(
                table_element,
                table,
                [
                    "Reference",
                    "Refcode"
                ]
            )


            fiducial_col = find_table_column(
                table_element,
                table,
                ["Fiducial"]
            )


            if z_col is None:
                continue


            for row in table:

                redshift = numeric_value(
                    row[z_col]
                )


                if not np.isfinite(
                    redshift
                ):
                    continue


                if unc_col is not None:

                    uncertainty = (
                        numeric_value(
                            row[unc_col]
                        )
                    )

                else:

                    uncertainty = np.nan


                if technique_col is not None:

                    technique = (
                        text_value(
                            row[
                                technique_col
                            ]
                        )
                    )

                else:

                    technique = ""


                if method_col is not None:

                    method = (
                        text_value(
                            row[
                                method_col
                            ]
                        )
                    )

                else:

                    method = ""


                if quality_col is not None:

                    quality = (
                        text_value(
                            row[
                                quality_col
                            ]
                        )
                    )

                else:

                    quality = ""


                if reference_col is not None:

                    reference = (
                        text_value(
                            row[
                                reference_col
                            ]
                        )
                    )

                else:

                    reference = ""


                if fiducial_col is not None:

                    fiducial = (
                        bool_value(
                            row[
                                fiducial_col
                            ]
                        )
                    )

                else:

                    fiducial = False


                measurements.append({

                    "redshift":
                        redshift,

                    "uncertainty":
                        uncertainty,

                    "technique":
                        technique,

                    "method":
                        method,

                    "quality":
                        quality,

                    "reference":
                        reference,

                    "fiducial":
                        fiducial
                })


    return (
        measurements,
        True
    )


# ============================================================
# SELECT NED SN REDSHIFT
# ============================================================

def select_ned_redshift(
    measurements
):

    if not measurements:
        return None


    # --------------------------------------------------------
    # FIRST CHOICE:
    # NED'S FIDUCIAL REDSHIFT
    # --------------------------------------------------------

    fiducial_rows = [

        measurement

        for measurement
        in measurements

        if measurement[
            "fiducial"
        ]
    ]


    if fiducial_rows:

        chosen = (
            fiducial_rows[0]
            .copy()
        )

        chosen[
            "selection"
        ] = "NED fiducial"

        return chosen


    # --------------------------------------------------------
    # FALLBACK TECHNIQUE RANKING
    # --------------------------------------------------------

    def technique_rank(text):

        text = (
            str(text)
            .strip()
            .upper()
        )


        if (
            "SPEC" in text
            or
            text == "S"
        ):
            return 0


        if "PHOT" in text:
            return 1


        if "MOD" in text:
            return 2


        if "MULT" in text:
            return 3


        if "INFD" in text:
            return 4


        return 5


    def measurement_rank(
        measurement
    ):

        quality = (
            measurement[
                "quality"
            ]
            .strip()
            .upper()
        )


        bad_quality = (
            1
            if (
                "?" in quality
                or
                "BAD" in quality
            )
            else 0
        )


        technique = (
            technique_rank(
                measurement[
                    "technique"
                ]
            )
        )


        uncertainty = (
            measurement[
                "uncertainty"
            ]
        )


        if np.isfinite(
            uncertainty
        ):

            uncertainty_missing = 0

        else:

            uncertainty_missing = 1
            uncertainty = np.inf


        return (

            bad_quality,

            technique,

            uncertainty_missing,

            uncertainty
        )


    chosen = sorted(
        measurements,
        key=measurement_rank
    )[0].copy()


    chosen[
        "selection"
    ] = "Best NED measurement"


    return chosen


# ============================================================
# GET FINAL SN REDSHIFT
# ============================================================

def get_supernova_redshift(
    sn_name
):

    (
        measurements,
        query_success
    ) = get_ned_redshift_measurements(
        sn_name
    )


    if not query_success:

        return {

            "redshift":
                np.nan,

            "uncertainty":
                np.nan,

            "technique":
                "",

            "method":
                "",

            "quality":
                "",

            "reference":
                "",

            "selection":
                "NED query failed",

            "measurement_count":
                0,

            "query_success":
                False
        }


    selected = (
        select_ned_redshift(
            measurements
        )
    )


    if selected is None:

        return {

            "redshift":
                np.nan,

            "uncertainty":
                np.nan,

            "technique":
                "",

            "method":
                "",

            "quality":
                "",

            "reference":
                "",

            "selection":
                "No NED redshift",

            "measurement_count":
                0,

            "query_success":
                True
        }


    selected[
        "measurement_count"
    ] = len(
        measurements
    )

    selected[
        "query_success"
    ] = True


    return selected


# ============================================================
# HOST MORPHOLOGY
# ============================================================

def get_host_morphology(
    votable
):

    morphology = get_text_exact(
        votable,
        [
            "Morphology"
        ]
    )


    morphology_reference = (
        get_text_exact(
            votable,
            [
                "Morphology Refcode"
            ]
        )
    )


    # Semantic fallback
    if not morphology:

        for record in all_field_records(
            votable
        ):

            name = normalize(
                record["name"]
            )

            field_id = normalize(
                record["id"]
            )

            description = normalize(
                record["description"]
            )


            looks_like_morphology = (

                name == "morphology"

                or

                field_id == "morphology"

                or

                "morphologicalclassification"
                in description

                or

                (
                    "morpholog" in description
                    and
                    "optical" in description
                )
            )


            if looks_like_morphology:

                morphology = (
                    first_text_from_record(
                        record
                    )
                )

                if morphology:
                    break


    return (
        morphology,
        morphology_reference
    )


