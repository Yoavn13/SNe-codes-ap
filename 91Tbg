# ============================================================
# BASIC HELPERS
# ============================================================

def clean_value(value):

    if value is None:
        return np.nan

    try:
        if np.ma.is_masked(value):
            return np.nan
    except Exception:
        pass

    if isinstance(value, bytes):
        return value.decode(
            "utf-8",
            errors="replace"
        ).strip()

    try:
        return value.item()
    except Exception:
        return value


def normalize(text):

    return "".join(
        ch.lower()
        for ch in str(text)
        if ch.isalnum()
    )


def numeric_value(value):

    value = clean_value(value)

    try:
        number = float(value)

        if np.isfinite(number):
            return number

    except Exception:
        pass

    return np.nan


def text_value(value):

    value = clean_value(value)

    try:
        if pd.isna(value):
            return ""
    except Exception:
        pass

    return str(value).strip()


def bool_value(value):

    value = clean_value(value)

    if isinstance(value, bool):
        return value

    text = str(value).strip().lower()

    return text in {
        "true",
        "1",
        "yes",
        "y",
        "t"
    }


# ============================================================
# REQUEST VOTABLE
# ============================================================

def request_votable(
    url,
    params,
    object_name
):

    for attempt in range(
        1,
        MAX_RETRIES + 1
    ):

        try:

            response = requests.get(
                url,
                params=params,
                timeout=60
            )

            response.raise_for_status()

            return parse(
                io.BytesIO(
                    response.content
                )
            )

        except Exception as error:

            print(
                "NED query failed:",
                object_name
            )

            print(
                "Attempt:",
                attempt
            )

            print(
                "Error:",
                error
            )

            if attempt < MAX_RETRIES:
                time.sleep(2)

    return None


# ============================================================
# VOTABLE FIELD RECORDS
# ============================================================

def all_field_records(votable):

    records = []

    if votable is None:
        return records

    for resource in votable.resources:

        for table_element in resource.tables:

            try:
                table = table_element.to_table()

            except Exception:
                continue

            if table is None or len(table) == 0:
                continue

            for index, field in enumerate(
                table_element.fields
            ):

                if index >= len(table.colnames):
                    continue

                records.append({
                    "table":
                        table,

                    "column":
                        table.colnames[index],

                    "name":
                        str(field.name or ""),

                    "id":
                        str(field.ID or ""),

                    "description":
                        str(field.description or ""),

                    "unit":
                        str(field.unit or "")
                })

    return records


def first_number_from_record(record):

    table = record["table"]
    column = record["column"]

    for value in table[column]:

        number = numeric_value(value)

        if np.isfinite(number):
            return number

    return np.nan


def first_text_from_record(record):

    table = record["table"]
    column = record["column"]

    for value in table[column]:

        text = text_value(value)

        if text:
            return text

    return ""


# ============================================================
# EXACT FIELD LOOKUPS
# ============================================================

def get_number_exact(
    votable,
    labels
):

    targets = [
        normalize(label)
        for label in labels
    ]

    for record in all_field_records(
        votable
    ):

        metadata = [
            normalize(record["name"]),
            normalize(record["id"])
        ]

        for target in targets:

            if target in metadata:

                value = (
                    first_number_from_record(
                        record
                    )
                )

                if np.isfinite(value):
                    return value

    return np.nan


def get_text_exact(
    votable,
    labels
):

    targets = [
        normalize(label)
        for label in labels
    ]

    for record in all_field_records(
        votable
    ):

        metadata = [
            normalize(record["name"]),
            normalize(record["id"])
        ]

        for target in targets:

            if target in metadata:

                value = (
                    first_text_from_record(
                        record
                    )
                )

                if value:
                    return value

    return ""


# ============================================================
# FIND COLUMN IN ONE TABLE
# ============================================================

def find_table_column(
    table_element,
    table,
    labels
):

    targets = [
        normalize(label)
        for label in labels
    ]

    for index, field in enumerate(
        table_element.fields
    ):

        if index >= len(table.colnames):
            continue

        names = [
            normalize(field.name or ""),
            normalize(field.ID or "")
        ]

        for target in targets:

            if target in names:
                return table.colnames[index]

    return None


# ============================================================
# NED REDSHIFT TABLE
# ============================================================

def get_ned_redshift_measurements(
    sn_name
):

    params = {
        "TARGET":
            str(sn_name).strip()
    }

    votable = request_votable(
        NED_REDSHIFTS_URL,
        params,
        sn_name
    )

    measurements = []

    if votable is None:
        return measurements

    for resource in votable.resources:

        for table_element in resource.tables:

            try:
                table = table_element.to_table()

            except Exception:
                continue

            if table is None or len(table) == 0:
                continue

            z_col = find_table_column(
                table_element,
                table,
                [
                    "Redshift (z)",
                    "Redshift"
                ]
            )

            unc_col = find_table_column(
                table_element,
                table,
                [
                    "Redshift(z) Unc",
                    "Redshift Unc"
                ]
            )

            technique_col = find_table_column(
                table_element,
                table,
                ["Technique"]
            )

            method_col = find_table_column(
                table_element,
                table,
                ["Method"]
            )

            quality_col = find_table_column(
                table_element,
                table,
                ["Quality Flag"]
            )

            reference_col = find_table_column(
                table_element,
                table,
                [
                    "Reference",
                    "Refcode"
                ]
            )

            fiducial_col = find_table_column(
                table_element,
                table,
                ["Fiducial"]
            )

            if z_col is None:
                continue

            for row in table:

                redshift = numeric_value(
                    row[z_col]
                )

                if not np.isfinite(redshift):
                    continue

                if unc_col is not None:
                    uncertainty = numeric_value(
                        row[unc_col]
                    )
                else:
                    uncertainty = np.nan

                if technique_col is not None:
                    technique = text_value(
                        row[technique_col]
                    )
                else:
                    technique = ""

                if method_col is not None:
                    method = text_value(
                        row[method_col]
                    )
                else:
                    method = ""

                if quality_col is not None:
                    quality = text_value(
                        row[quality_col]
                    )
                else:
                    quality = ""

                if reference_col is not None:
                    reference = text_value(
                        row[reference_col]
                    )
                else:
                    reference = ""

                if fiducial_col is not None:
                    fiducial = bool_value(
                        row[fiducial_col]
                    )
                else:
                    fiducial = False

                measurements.append({

                    "redshift":
                        redshift,

                    "uncertainty":
                        uncertainty,

                    "technique":
                        technique,

                    "method":
                        method,

                    "quality":
                        quality,

                    "reference":
                        reference,

                    "fiducial":
                        fiducial
                })

    return measurements


# ============================================================
# SELECT BEST NED REDSHIFT
# ============================================================

def select_ned_redshift(
    measurements
):

    if not measurements:
        return None

    # --------------------------------------------------------
    # First choice: NED Fiducial row
    # --------------------------------------------------------

    fiducial_rows = [
        measurement
        for measurement in measurements
        if measurement["fiducial"]
    ]

    if fiducial_rows:

        chosen = fiducial_rows[0].copy()

        chosen[
            "selection"
        ] = "NED fiducial redshift"

        return chosen

    # --------------------------------------------------------
    # Otherwise rank measurements
    # --------------------------------------------------------

    def technique_rank(text):

        text = str(text).strip().upper()

        if "SPEC" in text:
            return 0

        if text == "S":
            return 0

        if "PHOT" in text:
            return 1

        if "MULT" in text:
            return 2

        if "MOD" in text:
            return 3

        return 4

    def measurement_rank(
        measurement
    ):

        quality = (
            measurement[
                "quality"
            ]
            .strip()
            .upper()
        )

        # Put questionable rows later
        bad_quality = (
            1
            if (
                "?" in quality
                or "BAD" in quality
            )
            else 0
        )

        technique = (
            technique_rank(
                measurement[
                    "technique"
                ]
            )
        )

        uncertainty = (
            measurement[
                "uncertainty"
            ]
        )

        if np.isfinite(
            uncertainty
        ):
            uncertainty_missing = 0

        else:
            uncertainty_missing = 1
            uncertainty = np.inf

        return (
            bad_quality,
            technique,
            uncertainty_missing,
            uncertainty
        )

    chosen = sorted(
        measurements,
        key=measurement_rank
    )[0].copy()

    chosen[
        "selection"
    ] = "Best NED redshift-table measurement"

    return chosen


# ============================================================
# FINAL SN REDSHIFT QUERY
# ============================================================

def get_supernova_redshift(
    sn_name
):

    measurements = (
        get_ned_redshift_measurements(
            sn_name
