# ============================================================
# COORDINATES
# ============================================================

def get_coordinates(
    object_name
):

    params = {

        "TARGET":
            str(object_name).strip(),

        "RADIUS":
            0
    }

    votable = request_votable(
        NED_CONE_URL,
        params,
        object_name
    )

    if votable is None:

        return (
            np.nan,
            np.nan
        )


    # --------------------------------------------------------
    # DECIMAL DEGREES
    # --------------------------------------------------------

    ra = get_number_exact(
        votable,
        ["RA"]
    )

    dec = get_number_exact(
        votable,
        ["Dec"]
    )

    if (
        np.isfinite(ra)
        and
        np.isfinite(dec)
    ):

        return (
            ra,
            dec
        )


    # --------------------------------------------------------
    # SEXAGESIMAL FALLBACK
    # --------------------------------------------------------

    ra_text = get_text_exact(
        votable,
        [
            "RA-s"
        ]
    )

    dec_text = get_text_exact(
        votable,
        [
            "Dec-s"
        ]
    )

    if (
        ra_text
        and
        dec_text
    ):

        try:

            coord = SkyCoord(
                ra_text,
                dec_text,
                unit=(
                    u.hourangle,
                    u.deg
                ),
                frame="icrs"
            )

            return (
                coord.ra.deg,
                coord.dec.deg
            )

        except Exception:
            pass

    return (
        np.nan,
        np.nan
    )


# ============================================================
# QUERY SUPERNOVA
# ============================================================

def query_supernova(
    sn_name
):

    # --------------------------------------------------------
    # COORDINATES
    # --------------------------------------------------------

    sn_ra, sn_dec = (
        get_coordinates(
            sn_name
        )
    )


    # --------------------------------------------------------
    # REDSHIFT FROM NED REDSHIFTS TABLE
    # --------------------------------------------------------

    redshift_result = (
        get_supernova_redshift(
            sn_name
        )
    )

    sn_redshift = (
        redshift_result[
            "redshift"
        ]
    )


    # --------------------------------------------------------
    # STATUS
    # --------------------------------------------------------

    problems = []

    if not (
        np.isfinite(sn_ra)
        and
        np.isfinite(sn_dec)
    ):

        problems.append(
            "NO_SN_COORDINATES"
        )

    if not np.isfinite(
        sn_redshift
    ):

        problems.append(
            "NO_SN_REDSHIFT"
        )

    if problems:

        sn_status = ";".join(
            problems
        )

    else:

        sn_status = "OK"


    return {

        "sn_ra":
            sn_ra,

        "sn_dec":
            sn_dec,

        "sn_redshift":
            sn_redshift,

        "sn_redshift_unc":
            redshift_result[
                "uncertainty"
            ],

        "sn_redshift_technique":
            redshift_result[
                "technique"
            ],

        "sn_redshift_reference":
            redshift_result[
                "reference"
            ],

        "sn_redshift_selection":
            redshift_result[
                "selection"
            ],

        "sn_status":
            sn_status
    }


# ============================================================
# QUERY HOST GALAXY
# ============================================================

def query_host(
    host_name
):

    # --------------------------------------------------------
    # HOST COORDINATES
    # --------------------------------------------------------

    host_ra, host_dec = (
        get_coordinates(
            host_name
        )
    )


    # --------------------------------------------------------
    # HOST OVERVIEW
    # --------------------------------------------------------

    params = {
        "TARGET":
            str(host_name).strip()
    }

    votable = request_votable(
        NED_OVERVIEW_URL,
        params,
        host_name
    )


    if votable is None:

        return {

            "host_ra":
                host_ra,

            "host_dec":
                host_dec,

            "host_morphology":
                "",

            "host_morphology_reference":
                "",

            "mean_distance_mpc":
                np.nan,

            "hubble_distance_mpc":
                np.nan,

            "distance_mpc":
                np.nan,

            "distance_method":
                "NED overview failed",

            "diameter_kpc":
                np.nan,

            "diameter_arcsec":
                np.nan,

            "diameter_bandpass":
                "",

            "diameter_reference":
                "",

            "host_status":
                "OVERVIEW_QUERY_FAILED"
        }


    # ========================================================
    # MORPHOLOGY
    # ========================================================

    (
        host_morphology,
        host_morphology_reference
    ) = get_host_morphology(
        votable
    )


    # ========================================================
    # DISTANCE
    # ========================================================

    mean_distance = (
        get_mean_distance(
            votable
        )
    )

    hubble_distance = (
        get_hubble_distance(
            votable
        )
    )


    # Prefer Mean Distance
    if np.isfinite(
        mean_distance
    ):

        distance_mpc = (
            mean_distance
        )

        distance_method = (
            "Mean Distance"
        )


    # Otherwise CMB Hubble Distance
    elif np.isfinite(
        hubble_distance
    ):

        distance_mpc = (
            hubble_distance
        )

        distance_method = (
            "Hubble Distance (CMB)"
        )


    else:

        distance_mpc = np.nan

        distance_method = (
            "No distance available"
        )


    # ========================================================
    # DIAMETER
    # ========================================================

    diameter_kpc = (
