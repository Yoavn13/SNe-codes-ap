# QUERY SUPERNOVA
# ============================================================

def query_supernova(
    sn_name
):

    sn_ra, sn_dec = (
        get_coordinates(
            sn_name
        )
    )

    redshift_result = (
        get_supernova_redshift(
            sn_name
        )
    )

    problems = []

    if not (
        np.isfinite(sn_ra)
        and
        np.isfinite(sn_dec)
    ):
        problems.append(
            "NO_SN_COORDINATES"
        )

    if not np.isfinite(
        redshift_result[
            "redshift"
        ]
    ):
        problems.append(
            "NO_SN_REDSHIFT"
        )

    if problems:
        sn_status = ";".join(
            problems
        )
    else:
        sn_status = "OK"

    return {
        "sn_ra":
            sn_ra,

        "sn_dec":
            sn_dec,

        "sn_redshift":
            redshift_result[
                "redshift"
            ],

        "sn_redshift_unc":
            redshift_result[
                "uncertainty"
            ],

        "sn_redshift_source":
            redshift_result[
                "source"
            ],

        "sn_redshift_selection":
            redshift_result[
                "selection"
            ],

        "sn_redshift_technique":
            redshift_result[
                "technique"
            ],

        "sn_redshift_method":
            redshift_result[
                "method"
            ],

        "sn_redshift_quality":
            redshift_result[
                "quality"
            ],

        "sn_redshift_reference":
            redshift_result[
                "reference"
            ],

        "ned_redshift_measurement_count":
            redshift_result[
                "measurement_count"
            ],

        "sn_status":
            sn_status
    }


