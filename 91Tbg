                np.nan,

            "uncertainty":
                np.nan,

            "technique":
                "",

            "method":
                "",

            "quality":
                "",

            "reference":
                "",

            "selection":
                "No NED redshift available",

            "source":
                "",

            "measurement_count":
                0
        }

    selected["source"] = (
        "NED Redshifts table"
    )

    selected["measurement_count"] = (
        len(measurements)
    )

    return selected


# ============================================================
# DISTANCE HELPERS
# ============================================================

def get_mean_distance(
    votable
):

    value = get_number_exact(
        votable,
        ["Mean Distance"]
    )

    if np.isfinite(value):
        return value

    for record in all_field_records(
        votable
    ):

        name = normalize(
            record["name"]
        )

        description = normalize(
            record["description"]
        )

        unit = normalize(
            record["unit"]
        )

        if (
            "mpc" in unit
            and (
                "meandistance" in name
                or (
                    "mean" in description
                    and
                    "distance" in description
                )
            )
        ):

            value = (
                first_number_from_record(
                    record
                )
            )

            if np.isfinite(value):
                return value

    return np.nan


def get_hubble_distance(
    votable
):

    value = get_number_exact(
        votable,
        [
            "D (3K CMB)",
            "D3KCMB"
        ]
    )

    if np.isfinite(value):
        return value

    for record in all_field_records(
        votable
    ):

        name = normalize(
            record["name"]
        )

        description = normalize(
            record["description"]
        )

        unit = normalize(
            record["unit"]
        )

        if (
            "mpc" in unit
            and (
                "d3kcmb" in name
                or
                "hubbleflowdistance"
                in description
                or (
                    "distance" in description
                    and
                    "cmb" in description
                )
            )
        ):

            value = (
                first_number_from_record(
                    record
                )
            )

            if np.isfinite(value):
                return value

    return np.nan


