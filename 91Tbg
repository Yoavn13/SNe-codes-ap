def query_host(
    host_name
):

    host_ra, host_dec = (
        get_coordinates(
            host_name
        )
    )

    params = {
        "TARGET":
            str(host_name).strip()
    }

    votable = request_votable(
        NED_OVERVIEW_URL,
        params,
        host_name
    )

    if votable is None:

        return {
            "host_ra":
                host_ra,

            "host_dec":
                host_dec,

            "mean_distance_mpc":
                np.nan,

            "hubble_distance_mpc":
                np.nan,

            "distance_mpc":
                np.nan,

            "distance_method":
                "NED overview failed",

            "diameter_kpc":
                np.nan,

            "diameter_arcsec":
                np.nan,

            "diameter_bandpass":
                "",

            "diameter_reference":
                "",

            "host_status":
                "OVERVIEW_QUERY_FAILED"
        }

    mean_distance = (
        get_mean_distance(
            votable
        )
    )

    hubble_distance = (
        get_hubble_distance(
            votable
        )
    )

    if np.isfinite(
        mean_distance
    ):

        distance_mpc = mean_distance
        distance_method = (
            "Mean Distance"
        )

    elif np.isfinite(
        hubble_distance
    ):

        distance_mpc = (
            hubble_distance
        )

        distance_method = (
            "Hubble Distance (CMB)"
        )

    else:

        distance_mpc = np.nan

        distance_method = (
            "No distance available"
        )

    diameter_kpc = (
        get_physical_diameter(
            votable
        )
    )

    diameter_arcsec = (
        get_angular_diameter(
            votable
        )
    )

    diameter_bandpass = (
        get_text_exact(
            votable,
            ["Bandpass"]
        )
    )

    diameter_reference = (
        get_text_exact(
            votable,
            ["Diameter Refcode"]
        )
    )

    problems = []

    if not (
        np.isfinite(host_ra)
        and
        np.isfinite(host_dec)
    ):
        problems.append(
            "NO_HOST_COORDINATES"
        )

    if not np.isfinite(
        distance_mpc
    ):
        problems.append(
            "NO_DISTANCE"
        )

    if not np.isfinite(
        diameter_kpc
    ):
        problems.append(
            "NO_DIAMETER"
        )

    if problems:
        host_status = ";".join(
            problems
        )
    else:
        host_status = "OK"

    return {
        "host_ra":
            host_ra,

        "host_dec":
            host_dec,

        "mean_distance_mpc":
            mean_distance,

        "hubble_distance_mpc":
            hubble_distance,

        "distance_mpc":
            distance_mpc,

        "distance_method":
            distance_method,

        "diameter_kpc":
            diameter_kpc,

        "diameter_arcsec":
            diameter_arcsec,

        "diameter_bandpass":
            diameter_bandpass,

        "diameter_reference":
            diameter_reference,

        "host_status":
            host_status
    }


