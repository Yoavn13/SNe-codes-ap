# ============================================================
# NED COORDINATES
# ============================================================

def get_coordinates(
    object_name
):

    params = {

        "TARGET":
            str(object_name).strip(),

        "RADIUS":
            0
    }


    votable, query_success = request_votable(

        NED_CONE_URL,

        params,

        object_name,

        "coordinate"
    )


    if not query_success:

        return (
            np.nan,
            np.nan,
            False
        )


    if votable is None:

        return (
            np.nan,
            np.nan,
            True
        )


    # --------------------------------------------------------
    # DECIMAL DEGREE VALUES
    # --------------------------------------------------------

    ra = get_number_exact(
        votable,
        ["RA"]
    )


    dec = get_number_exact(
        votable,
        ["Dec"]
    )


    if (
        np.isfinite(ra)
        and
        np.isfinite(dec)
    ):

        return (
            ra,
            dec,
            True
        )


    # --------------------------------------------------------
    # SEXAGESIMAL FALLBACK
    # --------------------------------------------------------

    ra_text = get_text_exact(
        votable,
        [
            "RA-s"
        ]
    )


    dec_text = get_text_exact(
        votable,
        [
            "Dec-s"
        ]
    )


    if (
        ra_text
        and
        dec_text
    ):

        try:

            coordinate = SkyCoord(
                ra_text,
                dec_text,
                unit=(
                    u.hourangle,
                    u.deg
                ),
                frame="icrs"
            )


            return (

                coordinate.ra.deg,

                coordinate.dec.deg,

                True
            )


        except Exception:
            pass


    return (
        np.nan,
        np.nan,
        True
    )


# ============================================================
# QUERY ONE SUPERNOVA
# ============================================================

def query_supernova(
    sn_name
):

    (
        sn_ra,
        sn_dec,
        coordinate_query_success
    ) = get_coordinates(
        sn_name
    )


    redshift_result = (
        get_supernova_redshift(
            sn_name
        )
    )


    redshift_query_success = (
        redshift_result[
            "query_success"
        ]
    )


    # Only cache if both NED requests actually responded.
    cache_complete = (
        coordinate_query_success
        and
        redshift_query_success
    )


    problems = []


    if not coordinate_query_success:

        problems.append(
            "SN_COORDINATE_QUERY_FAILED"
        )

    elif not (
        np.isfinite(sn_ra)
        and
        np.isfinite(sn_dec)
    ):

        problems.append(
            "NO_SN_COORDINATES"
        )


    if not redshift_query_success:

        problems.append(
            "SN_REDSHIFT_QUERY_FAILED"
        )

    elif not np.isfinite(
        redshift_result[
            "redshift"
        ]
    ):

        problems.append(
            "NO_SN_REDSHIFT"
        )


    if problems:

        sn_status = ";".join(
            problems
        )

    else:

        sn_status = "OK"


    return {

        "sn_name":
            sn_name,

        "sn_ra":
            sn_ra,

        "sn_dec":
            sn_dec,

        "sn_redshift":
            redshift_result[
                "redshift"
            ],

        "sn_redshift_unc":
            redshift_result[
                "uncertainty"
            ],

        "sn_redshift_technique":
            redshift_result[
                "technique"
            ],

        "sn_redshift_reference":
            redshift_result[
                "reference"
            ],

        "sn_redshift_selection":
            redshift_result[
                "selection"
            ],

        "sn_status":
            sn_status,

        "cache_complete":
            cache_complete
    }


# ============================================================
# QUERY ONE HOST GALAXY
# ============================================================

def query_host(
    host_name
):

    (
        host_ra,
        host_dec,
        coordinate_query_success
    ) = get_coordinates(
        host_name
    )


    params = {

        "TARGET":
            str(host_name).strip()
    }


    (
        overview_votable,
        overview_query_success
    ) = request_votable(

        NED_OVERVIEW_URL,

        params,

        host_name,

        "host overview"
    )


    # Only cache when both required queries answered.
    cache_complete = (
        coordinate_query_success
        and
        overview_query_success
    )


    if overview_query_success:

        (
            host_morphology,
            host_morphology_reference
        ) = get_host_morphology(
            overview_votable
        )


        mean_distance = (
            get_mean_distance(
                overview_votable
            )
        )


        hubble_distance = (
            get_hubble_distance(
                overview_votable
            )
        )


        diameter_kpc = (
            get_physical_diameter(
                overview_votable
            )
        )


        diameter_arcsec = (
            get_angular_diameter(
                overview_votable
            )
        )


        diameter_bandpass = (
            get_text_exact(
                overview_votable,
                ["Bandpass"]
            )
        )


        diameter_reference = (
            get_text_exact(
                overview_votable,
                [
                    "Diameter Refcode"
                ]
            )
        )


    else:

        host_morphology = ""
        host_morphology_reference = ""

        mean_distance = np.nan
        hubble_distance = np.nan

        diameter_kpc = np.nan
        diameter_arcsec = np.nan

        diameter_bandpass = ""
        diameter_reference = ""


    # --------------------------------------------------------
    # DISTANCE SELECTION
    # --------------------------------------------------------

    if np.isfinite(
        mean_distance
    ):

        distance_mpc = (
            mean_distance
        )

        distance_method = (
            "Mean Distance"
        )


    elif np.isfinite(
        hubble_distance
    ):

        distance_mpc = (
            hubble_distance
        )

        distance_method = (
            "Hubble Distance (CMB)"
        )


    else:

        distance_mpc = np.nan

        distance_method = (
            "No distance available"
        )


    # --------------------------------------------------------
    # STATUS
    # --------------------------------------------------------

    problems = []


    if not coordinate_query_success:

        problems.append(
            "HOST_COORDINATE_QUERY_FAILED"
        )

    elif not (
        np.isfinite(host_ra)
        and
        np.isfinite(host_dec)
    ):

        problems.append(
            "NO_HOST_COORDINATES"
        )


    if not overview_query_success:

        problems.append(
            "OVERVIEW_QUERY_FAILED"
        )

    else:

        if not np.isfinite(
            distance_mpc
        ):

            problems.append(
                "NO_DISTANCE"
            )


        if not np.isfinite(
            diameter_kpc
        ):

            problems.append(
                "NO_DIAMETER"
            )


    if problems:

        host_status = ";".join(
            problems
        )

    else:

        host_status = "OK"


    return {

        "host_name":
            host_name,

        "host_ra":
            host_ra,

        "host_dec":
            host_dec,

        "host_morphology":
            host_morphology,

        "host_morphology_reference":
            host_morphology_reference,

        "mean_distance_mpc":
            mean_distance,

        "hubble_distance_mpc":
            hubble_distance,

        "distance_mpc":
            distance_mpc,

        "distance_method":
            distance_method,

        "diameter_kpc":
            diameter_kpc,

        "diameter_arcsec":
            diameter_arcsec,

        "diameter_bandpass":
            diameter_bandpass,

        "diameter_reference":
            diameter_reference,

        "host_status":
            host_status,

        "cache_complete":
            cache_complete
    }


