            ]
        )
    )

    diameter_reference = (
        get_text_exact(
            votable,
            [
                "Diameter Refcode"
            ]
        )
    )


    # ========================================================
    # STATUS
    # ========================================================

    problems = []

    if not (
        np.isfinite(host_ra)
        and
        np.isfinite(host_dec)
    ):

        problems.append(
            "NO_HOST_COORDINATES"
        )

    if not np.isfinite(
        distance_mpc
    ):

        problems.append(
            "NO_DISTANCE"
        )

    if not np.isfinite(
        diameter_kpc
    ):

        problems.append(
            "NO_DIAMETER"
        )


    if problems:

        host_status = ";".join(
            problems
        )

    else:

        host_status = "OK"


    return {

        "host_ra":
            host_ra,

        "host_dec":
            host_dec,

        "host_morphology":
            host_morphology,

        "host_morphology_reference":
