# BUILD OUTPUT TABLE
# ============================================================

output_rows = []


for _, row in df.iterrows():

    sn_name = row[
        SN_NAME_COL
    ]

    host_name = row[
        HOST_NAME_COL
    ]


    # ========================================================
    # SN RESULT
    # ========================================================

    sn_result = sn_cache.get(

        sn_name,

        {
            "sn_ra":
                np.nan,

            "sn_dec":
                np.nan,

            "sn_redshift":
                np.nan,

            "sn_redshift_unc":
                np.nan,

            "sn_redshift_technique":
                "",

            "sn_redshift_reference":
                "",

            "sn_redshift_selection":
                "",

            "sn_status":
                "SN_NOT_FOUND"
        }
    )


    # ========================================================
    # HOST RESULT
    # ========================================================

    host_result = host_cache.get(

        host_name,

        {
            "host_ra":
                np.nan,

            "host_dec":
                np.nan,

            "host_morphology":
                "",

            "host_morphology_reference":
                "",

            "mean_distance_mpc":
                np.nan,

            "hubble_distance_mpc":
                np.nan,

            "distance_mpc":
                np.nan,

            "distance_method":
                "",

            "diameter_kpc":
                np.nan,

            "diameter_arcsec":
                np.nan,

            "diameter_bandpass":
                "",

            "diameter_reference":
                "",

            "host_status":
                "HOST_NOT_FOUND"
        }
    )


    # ========================================================
    # VALUES
    # ========================================================

    sn_ra = (
        sn_result["sn_ra"]
    )

    sn_dec = (
        sn_result["sn_dec"]
    )


    host_ra = (
        host_result["host_ra"]
    )

    host_dec = (
        host_result["host_dec"]
    )


    distance_mpc = (
        host_result[
            "distance_mpc"
        ]
    )


    diameter_kpc = (
        host_result[
            "diameter_kpc"
        ]
    )


    # ========================================================
    # SN-HOST OFFSET
    # ========================================================

    offset_arcsec = np.nan
    offset_kpc = np.nan

    problems = []


    coordinates_ok = (
        np.isfinite(sn_ra)
        and
        np.isfinite(sn_dec)
        and
        np.isfinite(host_ra)
        and
        np.isfinite(host_dec)
    )


    if coordinates_ok:

        try:

            sn_coord = SkyCoord(
                ra=sn_ra * u.deg,
                dec=sn_dec * u.deg,
                frame="icrs"
            )


            host_coord = SkyCoord(
                ra=host_ra * u.deg,
                dec=host_dec * u.deg,
                frame="icrs"
            )


            separation = (
                sn_coord.separation(
                    host_coord
                )
            )


            offset_arcsec = (
                separation.to_value(
                    u.arcsec
                )
            )


            if np.isfinite(
                distance_mpc
            ):

                offset_kpc = (
                    distance_mpc
                    * 1000.0
                    * separation.to_value(
                        u.rad
                    )
                )

            else:

                problems.append(
                    "NO_DISTANCE_FOR_OFFSET"
                )


        except Exception as error:

            problems.append(
                "OFFSET_ERROR: "
                + str(error)
            )


    else:

        problems.append(
            "MISSING_COORDINATES_FOR_OFFSET"
        )


    # ========================================================
    # GALAXY RADIUS
    # ========================================================

    if (
        np.isfinite(diameter_kpc)
        and
        diameter_kpc > 0
    ):

        galaxy_radius_kpc = (
            diameter_kpc / 2.0
        )

    else:

        galaxy_radius_kpc = np.nan


    # ========================================================
    # NORMALIZED OFFSET
    # ========================================================

    if (
        np.isfinite(offset_kpc)
        and
        np.isfinite(
            galaxy_radius_kpc
        )
        and
        galaxy_radius_kpc > 0
    ):

        offset_over_galaxy_radius = (
            offset_kpc
            /
            galaxy_radius_kpc
        )

    else:

        offset_over_galaxy_radius = (
            np.nan
        )


    # ========================================================
    # FINAL STATUS
    # ========================================================

    if (
        sn_result["sn_status"]
        != "OK"
    ):

        problems.append(
            sn_result[
                "sn_status"
            ]
        )


    if (
        host_result[
            "host_status"
        ]
        != "OK"
    ):

        problems.append(
            host_result[
                "host_status"
            ]
        )


    if problems:

        final_status = ";".join(
            dict.fromkeys(
                problems
            )
        )

    else:

        final_status = "OK"


    # ========================================================
    # ORGANIZED OUTPUT
    # ========================================================

    output_rows.append({

