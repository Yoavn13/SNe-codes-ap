        print(
            "Ignoring old SN cache."
        )

        return cache


    if not os.path.exists(
        SN_CACHE_CSV
    ):

        return cache


    try:

        cache_df = pd.read_csv(
            SN_CACHE_CSV
        )


        for _, row in cache_df.iterrows():

            sn_name = text_value(
                row.get(
                    "sn_name",
                    ""
                )
            )


            if not sn_name:
                continue


            cache_complete = (
                str(
                    row.get(
                        "cache_complete",
                        False
                    )
                )
                .strip()
                .lower()
                in {
                    "true",
                    "1",
                    "yes"
