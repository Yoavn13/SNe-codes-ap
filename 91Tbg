            separation = (
                sn_coord.separation(
                    host_coord
                )
            )


            offset_arcsec = (
                separation.to_value(
                    u.arcsec
                )
            )


            if np.isfinite(
                distance_mpc
            ):

                offset_kpc = (

                    distance_mpc

                    * 1000.0

                    * separation.to_value(
                        u.rad
