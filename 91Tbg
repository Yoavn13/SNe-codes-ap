# ============================================================
# COORDINATES
# ============================================================

def get_coordinates(
    object_name
):

    params = {
        "TARGET":
            str(object_name).strip(),

        "RADIUS":
            0
    }

    votable = request_votable(
        NED_CONE_URL,
        params,
        object_name
    )

    if votable is None:
        return np.nan, np.nan

    ra = get_number_exact(
        votable,
        ["RA"]
    )

    dec = get_number_exact(
        votable,
        ["Dec"]
    )

    if (
        np.isfinite(ra)
        and np.isfinite(dec)
    ):
        return ra, dec

    ra_text = get_text_exact(
        votable,
        ["RA-s"]
    )

    dec_text = get_text_exact(
        votable,
        ["Dec-s"]
    )

    if ra_text and dec_text:

        try:

            coord = SkyCoord(
                ra_text,
                dec_text,
                unit=(
                    u.hourangle,
                    u.deg
                ),
                frame="icrs"
            )

            return (
                coord.ra.deg,
                coord.dec.deg
            )

        except Exception:
            pass

    return np.nan, np.nan


