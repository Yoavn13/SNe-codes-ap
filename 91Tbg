        {
            "sn_ra": np.nan,
            "sn_dec": np.nan,
            "sn_redshift": np.nan,
            "sn_redshift_unc": np.nan,
            "sn_redshift_source": "",
            "sn_redshift_selection": "",
            "sn_redshift_technique": "",
            "sn_redshift_method": "",
            "sn_redshift_quality": "",
            "sn_redshift_reference": "",
            "ned_redshift_measurement_count": 0,
            "sn_status": "SN_NOT_FOUND"
        }
    )

    host_result = host_cache.get(
        host_name,
        {
            "host_ra": np.nan,
            "host_dec": np.nan,
            "mean_distance_mpc": np.nan,
            "hubble_distance_mpc": np.nan,
            "distance_mpc": np.nan,
            "distance_method": "",
            "diameter_kpc": np.nan,
            "diameter_arcsec": np.nan,
            "diameter_bandpass": "",
            "diameter_reference": "",
            "host_status": "HOST_NOT_FOUND"
        }
    )

    sn_ra = sn_result["sn_ra"]
    sn_dec = sn_result["sn_dec"]

    host_ra = host_result["host_ra"]
    host_dec = host_result["host_dec"]

    distance_mpc = host_result[
        "distance_mpc"
    ]

    diameter_kpc = host_result[
        "diameter_kpc"
    ]

    offset_arcsec = np.nan
    offset_kpc = np.nan

    problems = []

    coordinates_ok = (
        np.isfinite(sn_ra)
        and
        np.isfinite(sn_dec)
        and
        np.isfinite(host_ra)
        and
        np.isfinite(host_dec)
    )

    if coordinates_ok:

        try:

            sn_coord = SkyCoord(
                ra=sn_ra * u.deg,
                dec=sn_dec * u.deg,
                frame="icrs"
            )

            host_coord = SkyCoord(
                ra=host_ra * u.deg,
                dec=host_dec * u.deg,
                frame="icrs"
            )

            separation = (
                sn_coord.separation(
                    host_coord
                )
            )

            offset_arcsec = (
                separation.to_value(
                    u.arcsec
                )
            )

            if np.isfinite(
                distance_mpc
            ):

                offset_kpc = (
                    distance_mpc
                    * 1000.0
                    * separation.to_value(
                        u.rad
                    )
                )

            else:

                problems.append(
                    "NO_DISTANCE_FOR_OFFSET"
                )

        except Exception as error:

            problems.append(
                "OFFSET_ERROR: "
                + str(error)
            )

    else:

        problems.append(
            "MISSING_COORDINATES_FOR_OFFSET"
        )

    if (
        np.isfinite(diameter_kpc)
        and
        diameter_kpc > 0
    ):

        galaxy_radius_kpc = (
            diameter_kpc / 2.0
        )

    else:

        galaxy_radius_kpc = np.nan

    if (
        np.isfinite(offset_kpc)
        and
        np.isfinite(
            galaxy_radius_kpc
        )
        and
        galaxy_radius_kpc > 0
    ):

        offset_over_galaxy_radius = (
            offset_kpc
            /
            galaxy_radius_kpc
        )

    else:

        offset_over_galaxy_radius = (
            np.nan
        )

    if (
        sn_result["sn_status"]
        != "OK"
    ):

        problems.append(
            sn_result[
                "sn_status"
            ]
        )

    if (
        host_result["host_status"]
        != "OK"
    ):

        problems.append(
            host_result[
                "host_status"
            ]
        )

    if problems:

        final_status = ";".join(
            dict.fromkeys(
                problems
            )
        )

    else:

        final_status = "OK"

    output_rows.append({

        "sn_name":
            sn_name,

        "sn_ra_ned":
            sn_ra,

        "sn_dec_ned":
            sn_dec,

        "sn_redshift":
            sn_result[
                "sn_redshift"
            ],

        "sn_redshift_unc":
            sn_result[
                "sn_redshift_unc"
            ],

        "sn_redshift_source":
            sn_result[
                "sn_redshift_source"
            ],

        "sn_redshift_selection":
            sn_result[
                "sn_redshift_selection"
            ],

        "sn_redshift_technique":
            sn_result[
                "sn_redshift_technique"
            ],

        "sn_redshift_method":
            sn_result[
                "sn_redshift_method"
            ],

        "sn_redshift_quality":
            sn_result[
                "sn_redshift_quality"
            ],

        "sn_redshift_reference":
            sn_result[
                "sn_redshift_reference"
            ],

        "ned_redshift_measurement_count":
            sn_result[
                "ned_redshift_measurement_count"
            ],

        "host_name":
            host_name,

        "host_ra_ned":
            host_ra,

        "host_dec_ned":
            host_dec,

        "mean_distance_mpc":
            host_result[
                "mean_distance_mpc"
            ],

        "hubble_distance_mpc":
            host_result[
                "hubble_distance_mpc"
            ],

        "distance_mpc":
            distance_mpc,

        "distance_method":
            host_result[
                "distance_method"
            ],

        "diameter_kpc":
            diameter_kpc,

        "galaxy_radius_kpc":
            galaxy_radius_kpc,

        "diameter_arcsec":
            host_result[
                "diameter_arcsec"
            ],

        "diameter_bandpass":
            host_result[
                "diameter_bandpass"
            ],

        "diameter_reference":
            host_result[
                "diameter_reference"
            ],

        "offset_arcsec":
            offset_arcsec,

        "offset_kpc":
            offset_kpc,

        "offset_over_galaxy_radius":
            offset_over_galaxy_radius,

        "sn_status":
            sn_result[
                "sn_status"
            ],

        "host_status":
            host_result[
                "host_status"
            ],

        "status":
            final_status
    })


# ============================================================
# SAVE
# ============================================================

output = pd.DataFrame(
    output_rows
)

output.to_csv(
    OUTPUT_CSV,
