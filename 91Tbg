# ============================================================
# CONNECTION SETTINGS
# ============================================================

MAX_RETRIES = 5

# Time between normal object queries
QUERY_DELAY = 1.0

# Longer timeout because NED can occasionally be slow
REQUEST_TIMEOUT = 90


# ============================================================
# BASIC HELPERS
# ============================================================

def clean_value(value):

    if value is None:
        return np.nan

    try:
        if np.ma.is_masked(value):
            return np.nan
    except Exception:
        pass

    if isinstance(value, bytes):

        return value.decode(
            "utf-8",
            errors="replace"
        ).strip()

    try:
        return value.item()

    except Exception:
        return value


def normalize(text):

    return "".join(
        ch.lower()
        for ch in str(text)
        if ch.isalnum()
    )


def numeric_value(value):

    value = clean_value(value)

    try:

        number = float(value)

        if np.isfinite(number):
            return number

    except Exception:
        pass

    return np.nan


def text_value(value):

    value = clean_value(value)

    try:

        if pd.isna(value):
            return ""

    except Exception:
        pass

    return str(value).strip()


def bool_value(value):

    value = clean_value(value)

    if isinstance(value, bool):
        return value

    text = str(value).strip().lower()

    return text in {
        "true",
        "1",
        "yes",
        "y",
        "t"
    }


# ============================================================
# NED REQUEST
# ============================================================

def request_votable(
    url,
    params,
    object_name
):

    for attempt in range(
        1,
        MAX_RETRIES + 1
    ):

        try:

            response = requests.get(
                url,
                params=params,
                timeout=REQUEST_TIMEOUT
            )

            response.raise_for_status()

            return parse(
                io.BytesIO(
                    response.content
                )
            )

        except Exception as error:

            print()
            print(
                "NED query failed:",
                object_name
            )

            print(
                "Attempt:",
                attempt,
                "of",
                MAX_RETRIES
            )

            print(
                "Error:",
                error
            )

            if attempt < MAX_RETRIES:

                # Progressive waiting:
                # 5, 10, 20, 40 seconds
                wait_time = 5 * (
                    2 ** (attempt - 1)
                )

                print(
                    "Waiting",
                    wait_time,
                    "seconds before retry..."
                )

                time.sleep(
                    wait_time
                )

    print(
        "Giving up on this NED request:",
        object_name
    )

    return None


# ============================================================
# READ ALL VOTABLE FIELDS
# ============================================================

def all_field_records(votable):

    records = []

    if votable is None:
        return records

    for resource in votable.resources:

        for table_element in resource.tables:

            try:

                table = (
                    table_element.to_table()
                )

            except Exception:
                continue

            if table is None:
                continue

            if len(table) == 0:
                continue

            for index, field in enumerate(
                table_element.fields
            ):

                if index >= len(
                    table.colnames
                ):
                    continue

                records.append({

                    "table":
                        table,

                    "column":
                        table.colnames[index],

                    "name":
                        str(
                            field.name or ""
                        ),

                    "id":
                        str(
                            field.ID or ""
                        ),

                    "description":
                        str(
                            field.description or ""
                        ),

                    "unit":
                        str(
                            field.unit or ""
                        )
                })

    return records


# ============================================================
# VALUES FROM VOTABLE FIELD
# ============================================================

def first_number_from_record(
    record
):

    table = record["table"]
    column = record["column"]

    for value in table[column]:

        number = numeric_value(
            value
        )

        if np.isfinite(number):
            return number

    return np.nan


def first_text_from_record(
    record
):

    table = record["table"]
    column = record["column"]

    for value in table[column]:

        text = text_value(
            value
        )

        if text:
            return text

    return ""


# ============================================================
# EXACT FIELD LOOKUP
# ============================================================

def get_number_exact(
    votable,
    labels
):

    targets = [
        normalize(label)
        for label in labels
    ]

    for record in all_field_records(
        votable
    ):

        field_name = normalize(
            record["name"]
        )

        field_id = normalize(
            record["id"]
        )

        for target in targets:

            if (
                field_name == target
                or
                field_id == target
            ):

                value = (
                    first_number_from_record(
                        record
                    )
                )

                if np.isfinite(value):
                    return value

    return np.nan


def get_text_exact(
    votable,
    labels
):

    targets = [
        normalize(label)
        for label in labels
    ]

    for record in all_field_records(
        votable
    ):

        field_name = normalize(
            record["name"]
        )

        field_id = normalize(
            record["id"]
        )

        for target in targets:

            if (
                field_name == target
                or
                field_id == target
            ):

                value = (
                    first_text_from_record(
                        record
                    )
                )

                if value:
                    return value

    return ""


# ============================================================
# FIND COLUMN IN ONE VOTABLE TABLE
# ============================================================

def find_table_column(
    table_element,
    table,
    labels
):

    targets = [
        normalize(label)
        for label in labels
    ]

    for index, field in enumerate(
        table_element.fields
    ):

        if index >= len(
            table.colnames
        ):
            continue

        possible_names = [

            normalize(
                field.name or ""
            ),

            normalize(
                field.ID or ""
            )
        ]

        for target in targets:

            if target in possible_names:

                return (
                    table.colnames[index]
                )

    return None


# ============================================================
# SUPERNOVA REDSHIFTS FROM NED REDSHIFTS TABLE
# ============================================================

def get_ned_redshift_measurements(
    sn_name
):

    params = {
        "TARGET":
            str(sn_name).strip()
    }

    votable = request_votable(
        NED_REDSHIFTS_URL,
        params,
        sn_name
    )

    measurements = []

    if votable is None:
        return measurements

    for resource in votable.resources:

        for table_element in resource.tables:

            try:

                table = (
                    table_element.to_table()
                )

            except Exception:
                continue

            if (
                table is None
                or
                len(table) == 0
            ):
                continue


            # ------------------------------------------------
            # REDSHIFT
            # ------------------------------------------------

            z_col = find_table_column(
                table_element,
                table,
                [
                    "Redshift (z)",
                    "Redshift"
                ]
            )


            # ------------------------------------------------
            # UNCERTAINTY
            # ------------------------------------------------

            unc_col = find_table_column(
                table_element,
                table,
                [
                    "Redshift(z) Unc",
                    "Redshift Unc"
                ]
            )


            # ------------------------------------------------
            # TECHNIQUE
            # ------------------------------------------------

            technique_col = (
                find_table_column(
                    table_element,
                    table,
                    [
                        "Technique"
                    ]
                )
            )


            # ------------------------------------------------
            # METHOD
            # ------------------------------------------------

            method_col = (
                find_table_column(
                    table_element,
                    table,
                    [
                        "Method"
                    ]
                )
            )


            # ------------------------------------------------
            # QUALITY
            # ------------------------------------------------

            quality_col = (
                find_table_column(
                    table_element,
                    table,
                    [
                        "Quality Flag"
                    ]
                )
            )


            # ------------------------------------------------
            # REFERENCE
            # ------------------------------------------------

            reference_col = (
                find_table_column(
                    table_element,
                    table,
                    [
                        "Reference",
                        "Refcode"
                    ]
                )
            )


            # ------------------------------------------------
            # FIDUCIAL FLAG
            # ------------------------------------------------

            fiducial_col = (
                find_table_column(
                    table_element,
                    table,
                    [
                        "Fiducial"
                    ]
                )
            )


            if z_col is None:
                continue


            # ------------------------------------------------
            # READ EVERY REDSHIFT MEASUREMENT
            # ------------------------------------------------

            for row in table:

                redshift = numeric_value(
                    row[z_col]
                )

                if not np.isfinite(
                    redshift
                ):
                    continue


                if unc_col is not None:

                    uncertainty = (
                        numeric_value(
                            row[unc_col]
                        )
                    )

                else:

                    uncertainty = np.nan


                if technique_col is not None:

                    technique = (
                        text_value(
                            row[
                                technique_col
                            ]
                        )
                    )

                else:

                    technique = ""


                if method_col is not None:

                    method = text_value(
                        row[method_col]
                    )

                else:

                    method = ""


                if quality_col is not None:

                    quality = text_value(
                        row[quality_col]
                    )

                else:

                    quality = ""


                if reference_col is not None:

                    reference = (
                        text_value(
                            row[
                                reference_col
                            ]
                        )
                    )

                else:

                    reference = ""


                if fiducial_col is not None:

                    fiducial = (
                        bool_value(
                            row[
                                fiducial_col
                            ]
                        )
                    )

                else:

                    fiducial = False


                measurements.append({

                    "redshift":
                        redshift,

                    "uncertainty":
                        uncertainty,

                    "technique":
                        technique,

                    "method":
                        method,

                    "quality":
                        quality,

                    "reference":
                        reference,

                    "fiducial":
                        fiducial
                })

    return measurements


# ============================================================
# CHOOSE BEST SN REDSHIFT
# ============================================================

def select_ned_redshift(
    measurements
):

    if not measurements:
        return None


    # ========================================================
    # FIRST CHOICE:
    # NED FIDUCIAL REDSHIFT
    # ========================================================

    fiducial_rows = [

        measurement

        for measurement
        in measurements

        if measurement[
            "fiducial"
        ]
    ]

    if fiducial_rows:

        # Prefer fiducial without a questionable flag
        good_fiducial = [

            measurement

            for measurement
            in fiducial_rows

            if "?" not in
            measurement[
                "quality"
            ]
        ]

        if good_fiducial:

            chosen = (
                good_fiducial[0]
                .copy()
            )

        else:

            chosen = (
                fiducial_rows[0]
                .copy()
            )

        chosen[
            "selection"
        ] = "NED fiducial"

        return chosen


    # ========================================================
    # OTHERWISE RANK AVAILABLE MEASUREMENTS
    # ========================================================

    def technique_rank(text):

        text = (
            str(text)
            .strip()
            .upper()
        )

        # Spectroscopic first
        if (
            "SPEC" in text
            or
            text == "S"
        ):
            return 0

        # Photometric next
        if "PHOT" in text:
            return 1

        # Multiple / mixed
        if "MULT" in text:
            return 2

        # Model
        if "MOD" in text:
            return 3

        return 4


    def measurement_rank(
        measurement
    ):

        quality = (
            measurement[
                "quality"
            ]
            .strip()
            .upper()
        )

        questionable = (
            1
            if (
                "?" in quality
                or
                "BAD" in quality
            )
            else 0
        )

        technique = (
            technique_rank(
                measurement[
                    "technique"
                ]
            )
        )

        uncertainty = (
            measurement[
                "uncertainty"
            ]
        )

        if np.isfinite(
            uncertainty
        ):

            missing_uncertainty = 0

        else:

            missing_uncertainty = 1
            uncertainty = np.inf

        return (
            questionable,
            technique,
            missing_uncertainty,
            uncertainty
        )


    chosen = sorted(
        measurements,
        key=measurement_rank
    )[0].copy()

    chosen[
        "selection"
    ] = "Best NED measurement"

    return chosen


# ============================================================
# FINAL SN REDSHIFT
# ============================================================

def get_supernova_redshift(
    sn_name
):

    measurements = (
        get_ned_redshift_measurements(
            sn_name
        )
    )

    selected = (
        select_ned_redshift(
            measurements
        )
    )

    if selected is None:

        return {

            "redshift":
                np.nan,

            "uncertainty":
                np.nan,

            "technique":
                "",

            "reference":
                "",

            "selection":
                "No NED redshift"
        }

    return selected


# ============================================================
# HOST MORPHOLOGY
# ============================================================

def get_host_morphology(
    votable
):

    if votable is None:

        return (
            "",
            ""
        )


    # NED OverviewOfObject officially provides:
    #
    # Morphology
    # Morphology Refcode

    morphology = (
        get_text_exact(
            votable,
            [
                "Morphology"
            ]
        )
    )

    morphology_reference = (
        get_text_exact(
            votable,
            [
                "Morphology Refcode"
            ]
        )
    )


    # --------------------------------------------------------
    # FALLBACK IF FIELD NAME VARIES
    # --------------------------------------------------------

    if not morphology:

        for record in all_field_records(
            votable
        ):

            field_name = normalize(
                record["name"]
            )

            field_id = normalize(
                record["id"]
            )

            description = normalize(
                record["description"]
            )

            looks_like_morphology = (
                field_name
                == "morphology"
                or
                field_id
                == "morphology"
                or
                (
                    "optical" in description
                    and
                    "morpholog" in description
                )
            )

            if looks_like_morphology:

                value = (
                    first_text_from_record(
                        record
                    )
                )

                if value:

                    morphology = value
                    break


    return (
        morphology,
        morphology_reference
    )


# ============================================================
# HOST MEAN DISTANCE
# ============================================================

def get_mean_distance(
    votable
):

    value = get_number_exact(
        votable,
        [
            "Mean Distance"
        ]
    )

    if np.isfinite(value):
        return value


    for record in all_field_records(
        votable
    ):

        name = normalize(
            record["name"]
        )

        description = normalize(
            record["description"]
        )

        unit = normalize(
            record["unit"]
        )

        looks_correct = (
            "mpc" in unit
            and
            (
                "meandistance"
                in name

                or

                (
                    "mean"
                    in description
                    and
                    "distance"
                    in description
                )
            )
        )

        if looks_correct:

            value = (
                first_number_from_record(
                    record
                )
            )

            if np.isfinite(value):
                return value

    return np.nan


